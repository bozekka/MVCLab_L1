@model Band
@{
    ViewData["Title"] = "Edycja zespołu";
}

<section class="poster-head">
    <p class="eyebrow">Formularz</p>
    <h1 class="poster-title">Edytuj zespół</h1>
</section>

<div class="form-card">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
        <div class="form-group">
            <label asp-for="Name"></label>
            <input asp-for="Name" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Genre"></label>
            <select asp-for="Genre" asp-items="Html.GetEnumSelectList<MusicGenre>()"></select>
            <span asp-validation-for="Genre" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Country"></label>
            <input asp-for="Country" />
            <span asp-validation-for="Country" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Description"></label>
            <textarea asp-for="Description"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="actions">
            <button type="submit" class="btn btn-primary">Zapisz zmiany</button>
            <a class="btn" asp-action="Index">Anuluj</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
 