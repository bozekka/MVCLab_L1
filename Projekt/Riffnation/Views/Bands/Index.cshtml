@model IEnumerable<Band>
@{
    ViewData["Title"] = "Zespoły";
    var isAdmin = Context.Session.GetString("IsAdmin") == "1";
}

<section class="poster-head">
    <p class="eyebrow">Wykonawcy</p>
    <h1 class="poster-title">Zespoły</h1>
</section>

<div class="toolbar">
    <span class="muted">Łącznie: @Model.Count() zespołów</span>
    @if (isAdmin)
    {
        <a class="btn btn-primary" asp-action="Create">+ Dodaj zespol</a>
    }
</div>

@if (!Model.Any())
{
    <div class="empty">Brak zespołów.</div>
}
else
{
    <div class="table-wrap">
        <table class="data">
            <thead>
                <tr>
                    <th>Nazwa</th>
                    <th>Gatunek</th>
                    <th>Kraj</th>
                    <th>Opis</th>
                    @if (isAdmin) { <th></th> }
                </tr>
            </thead>
            <tbody>
            @foreach (var band in Model)
            {
                <tr>
                    <td class="evt-name">@band.Name</td>
                    <td><span class="tag tag-genre">@band.Genre.GetDisplayName()</span></td>
                    <td class="muted">@band.Country</td>
                    <td class="muted" style="font-size:.84rem;max-width:340px;">@band.Description</td>
                    @if (isAdmin)
                    {
                        <td style="white-space:nowrap">
                            <a class="btn btn-sm" asp-action="Edit"   asp-route-id="@band.Id">Edytuj</a>
                            <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@band.Id">Usuń</a>
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
}
 